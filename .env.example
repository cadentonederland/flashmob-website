# Public site URL (used for metadata / OG)
NEXT_PUBLIC_SITE_URL=https://flashmob.gg

# Minecraft server address shown on IP pills
NEXT_PUBLIC_SERVER_ADDRESS=play.flashmob.gg

# Full Discord invite. Leave empty to show a "coming soon" toast.
NEXT_PUBLIC_DISCORD_URL=

# Live player count via mcsrvstat.us
NEXT_PUBLIC_SHOW_PLAYER_COUNT=true

# Signed session cookies (change before launch)
AUTH_SECRET=replace-with-a-long-random-string

# Minecraft plugin calls POST /api/auth/confirm-verify with this bearer token
AUTH_PLUGIN_SECRET=dev-plugin-secret

# --- Ready for later ---
# DATABASE_URL=
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
